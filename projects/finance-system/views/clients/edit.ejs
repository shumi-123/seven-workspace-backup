<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑委托人 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item active">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑委托人</h1>
  <form class="form-inline" action="/clients/edit/<%= client.id %>" method="POST">
    <div class="form-group"><label>委托人名称</label><input name="name" value="<%= client.name %>" required></div>
    <div class="form-group"><label>联系人</label><input name="contact" value="<%= client.contact||'' %>"></div>
    <div class="form-group"><label>电话</label><input name="phone" value="<%= client.phone||'' %>"></div>
    <div class="form-group"><label>邮箱</label><input name="email" value="<%= client.email||'' %>"></div>
    <div class="form-group"><label>身份证号</label><input name="id_card" value="<%= client.id_card||'' %>"></div>
    <div class="form-group"><label>公司</label><input name="company" value="<%= client.company||'' %>"></div>
    <div class="form-group"><label>地址</label><input name="address" value="<%= client.address||'' %>"></div>
    <div class="form-group"><label>备注</label><input name="remark" value="<%= client.remark||'' %>"></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/clients" class="btn">取消</a>
  </form>
</main>
</body>
</html>
