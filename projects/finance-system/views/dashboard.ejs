<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>仪表盘 | 财务结算系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="sidebar">
    <div class="logo">财务系统</div>
    <a href="/dashboard" class="nav-item active">仪表盘</a>
    <a href="/clients" class="nav-item">客户管理</a>
    <a href="/projects" class="nav-item">项目管理</a>
    <a href="/payments" class="nav-item">收款管理</a>
    <a href="/invoices" class="nav-item">发票管理</a>
    <a href="/costs" class="nav-item">成本管理</a>
    <a href="/performance" class="nav-item">绩效分配</a>
  </nav>
  <main class="content">
    <h1>智能监控仪表盘</h1>
    <div class="card-grid">
      <div class="card">
        <h3>总收款</h3>
        <div class="value green">¥<%= stats.totalRevenue.toFixed(2) %></div>
      </div>
      <div class="card">
        <h3>总成本</h3>
        <div class="value red">¥<%= stats.totalCost.toFixed(2) %></div>
      </div>
      <div class="card">
        <h3>净利润</h3>
        <div class="value <%= stats.profit >= 0 ? 'blue' : 'red' %>">¥<%= stats.profit.toFixed(2) %></div>
      </div>
      <div class="card">
        <h3>绩效支出</h3>
        <div class="value">¥<%= stats.totalPerformance.toFixed(2) %></div>
      </div>
      <div class="card">
        <h3>客户数</h3>
        <div class="value blue"><%= stats.clientCount %></div>
      </div>
      <div class="card">
        <h3>项目数 / 进行中</h3>
        <div class="value"><%= stats.projectCount %> / <%= stats.activeProjects %></div>
      </div>
    </div>

    <div class="chart-row">
      <div class="chart-box">
        <h2>成本分类</h2>
        <table>
          <tr><th>分类</th><th>金额</th></tr>
          <% costByCategory.forEach(c => { %>
            <tr><td><%= c.category %></td><td>¥<%= c.total.toFixed(2) %></td></tr>
          <% }) %>
          <% if (!costByCategory.length) { %>
            <tr><td colspan="2" style="text-align:center;color:#888;">暂无数据</td></tr>
          <% } %>
        </table>
      </div>
      <div class="chart-box">
        <h2>近30天收款</h2>
        <table>
          <tr><th>月份</th><th>金额</th></tr>
          <% recentPayments.forEach(p => { %>
            <tr><td><%= p.month %></td><td>¥<%= p.total.toFixed(2) %></td></tr>
          <% }) %>
          <% if (!recentPayments.length) { %>
            <tr><td colspan="2" style="text-align:center;color:#888;">暂无数据</td></tr>
          <% } %>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
