<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>工资管理 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item active">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>工资管理（自动计算个税）</h1>
  <form class="form-inline" action="/salaries/add" method="POST">
    <div class="form-group"><label>律师</label><select name="lawyer_id" required><% lawyers.forEach(l => { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></div>
    <div class="form-group"><label>年份</label><input name="year" type="number" value="<%= new Date().getFullYear() %>"></div>
    <div class="form-group"><label>月份</label><input name="month" type="number" min="1" max="12" value="<%= new Date().getMonth()+1 %>"></div>
    <div class="form-group"><label>基本工资</label><input name="base_salary" type="number" step="0.01" value="0"></div>
    <div class="form-group"><label>提成</label><input name="commission" type="number" step="0.01" value="0"></div>
    <div class="form-group"><label>奖金</label><input name="bonus" type="number" step="0.01" value="0"></div>
    <div class="form-group"><label>扣款</label><input name="deduction" type="number" step="0.01" value="0"></div>
    <div class="form-group"><label>社保</label><input name="social_insurance" type="number" step="0.01" value="0"></div>
    <div class="form-group"><label>公积金</label><input name="housing_fund" type="number" step="0.01" value="0"></div>
    <div class="form-group"><label>其他扣除</label><input name="other_deduction" type="number" step="0.01" value="0"></div>
    <div class="form-group"><label>备注</label><input name="remark"></div>
    <button class="btn btn-primary" type="submit">计算并保存</button>
  </form>
  <table>
    <tr><th>ID</th><th>律师</th><th>年月</th><th>基本工资</th><th>提成</th><th>奖金</th><th>应发</th><th>社保</th><th>公积金</th><th>个税</th><th>实发</th><th>操作</th></tr>
    <% salaries.forEach(s => { %>
      <tr>
        <td><%= s.id %></td><td><%= s.lawyer_name||'-' %></td><td><%= s.year %>-<%= s.month %></td>
        <td>¥<%= s.base_salary.toFixed(2) %></td><td>¥<%= s.commission.toFixed(2) %></td><td>¥<%= s.bonus.toFixed(2) %></td>
        <td>¥<%= s.gross_salary.toFixed(2) %></td><td>¥<%= s.social_insurance.toFixed(2) %></td>
        <td>¥<%= s.housing_fund.toFixed(2) %></td><td>¥<%= s.tax.toFixed(2) %></td>
        <td><strong>¥<%= s.net_salary.toFixed(2) %></strong></td>
        <td><form action="/salaries/delete/<%= s.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger">删除</button></form></td>
      </tr>
    <% }) %>
  </table>
</main>
</body>
</html>