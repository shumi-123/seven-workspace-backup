<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑工资 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item active">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑工资</h1>
  <form class="form-inline" action="/salaries/edit/<%= salary.id %>" method="POST">
    <div class="form-group"><label>律师</label><select name="lawyer_id" required><% lawyers.forEach(l => { %><option value="<%= l.id %>" <%= salary.lawyer_id==l.id?'selected':'' %>><%= l.name %></option><% }) %></select></div>
    <div class="form-group"><label>年份</label><input name="year" type="number" value="<%= salary.year||2026 %>"></div>
    <div class="form-group"><label>月份</label><input name="month" type="number" min="1" max="12" value="<%= salary.month||1 %>"></div>
    <div class="form-group"><label>基本工资</label><input name="base_salary" type="number" step="0.01" value="<%= salary.base_salary||0 %>"></div>
    <div class="form-group"><label>提成</label><input name="commission" type="number" step="0.01" value="<%= salary.commission||0 %>"></div>
    <div class="form-group"><label>奖金</label><input name="bonus" type="number" step="0.01" value="<%= salary.bonus||0 %>"></div>
    <div class="form-group"><label>扣款</label><input name="deduction" type="number" step="0.01" value="<%= salary.deduction||0 %>"></div>
    <div class="form-group"><label>社保</label><input name="social_insurance" type="number" step="0.01" value="<%= salary.social_insurance||0 %>"></div>
    <div class="form-group"><label>公积金</label><input name="housing_fund" type="number" step="0.01" value="<%= salary.housing_fund||0 %>"></div>
    <div class="form-group"><label>其他扣除</label><input name="other_deduction" type="number" step="0.01" value="<%= salary.other_deduction||0 %>"></div>
    <div class="form-group"><label>备注</label><input name="remark" value="<%= salary.remark||'' %>"></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/salaries" class="btn">取消</a>
  </form>
</main>
</body>
</html>
