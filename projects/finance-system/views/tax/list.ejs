<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>个税管理 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item active">个税管理</a>
</nav>
<main class="content">
  <h1>个税管理</h1>
  <form class="form-inline" action="/tax" method="GET">
    <div class="form-group"><label>年份</label><input name="year" type="number" value="<%= year %>"></div>
    <div class="form-group"><label>月份</label><input name="month" type="number" min="1" max="12" value="<%= month %>"></div>
    <button class="btn btn-primary" type="submit">查询</button>
  </form>
  <div class="card-grid">
    <div class="card"><h3>应发总额</h3><div class="value">¥<%= totalGross.toFixed(2) %></div></div>
    <div class="card"><h3>个税总额</h3><div class="value red">¥<%= totalTax.toFixed(2) %></div></div>
    <div class="card"><h3>实发总额</h3><div class="value green">¥<%= totalNet.toFixed(2) %></div></div>
    <div class="card"><h3>社保总额</h3><div class="value">¥<%= totalSocial.toFixed(2) %></div></div>
    <div class="card"><h3>公积金总额</h3><div class="value">¥<%= totalHousing.toFixed(2) %></div></div>
  </div>
  <h2><%= year %>年<%= month %>月 个税明细</h2>
  <table>
    <tr><th>律师</th><th>应发</th><th>社保</th><th>公积金</th><th>应纳税所得额</th><th>个税</th><th>实发</th></tr>
    <% taxRecords.forEach(t => { %>
      <tr>
        <td><%= t.lawyer_name||'-' %></td>
        <td>¥<%= t.gross_salary.toFixed(2) %></td>
        <td>¥<%= t.social_insurance.toFixed(2) %></td>
        <td>¥<%= t.housing_fund.toFixed(2) %></td>
        <td>¥<%= t.taxable_income.toFixed(2) %></td>
        <td><strong class="red">¥<%= t.tax.toFixed(2) %></strong></td>
        <td><strong>¥<%= t.net_salary.toFixed(2) %></strong></td>
      </tr>
    <% }) %>
    <% if (!taxRecords.length) { %>
      <tr><td colspan="7" style="text-align:center;color:#888;">该月份暂无数据，请先在工资管理录入</td></tr>
    <% } %>
  </table>
  <div class="chart-box" style="margin-top:20px;">
    <h2>综合所得税率表</h2>
    <table>
      <tr><th>级数</th><th>全年应纳税所得额</th><th>税率</th><th>速算扣除数</th></tr>
      <tr><td>1</td><td>不超过36,000</td><td>3%</td><td>0</td></tr>
      <tr><td>2</td><td>36,000 ~ 144,000</td><td>10%</td><td>2,520</td></tr>
      <tr><td>3</td><td>144,000 ~ 300,000</td><td>20%</td><td>16,920</td></tr>
      <tr><td>4</td><td>300,000 ~ 420,000</td><td>25%</td><td>31,920</td></tr>
      <tr><td>5</td><td>420,000 ~ 660,000</td><td>30%</td><td>52,920</td></tr>
      <tr><td>6</td><td>660,000 ~ 960,000</td><td>35%</td><td>85,920</td></tr>
      <tr><td>7</td><td>超过960,000</td><td>45%</td><td>181,920</td></tr>
    </table>
    <p style="color:#64748b;font-size:12px;margin-top:10px;">注：系统按月计税，5000元/月起征点，已扣除社保公积金及专项附加扣除。以上为年度税率参考。</p>
  </div>
</main>
</body>
</html>