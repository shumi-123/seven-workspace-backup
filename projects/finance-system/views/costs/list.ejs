<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>成本管理 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item active">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>成本管理 <a href="/export/costs/list" class="btn">导出CSV</a></h1>
  <form class="form-inline" action="/costs/add" method="POST">
    <div class="form-group"><label>分类</label>
      <select name="category" required>
        <option value="律师工资">律师工资</option><option value="社保公积金">社保公积金</option><option value="办案费">办案费</option>
        <option value="平台费用">平台费用</option><option value="办公费">办公费</option><option value="律所管理费">律所管理费</option><option value="其他">其他</option>
      </select>
    </div>
    <div class="form-group"><label>子分类</label><input name="subcategory"></div>
    <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" required></div>
    <div class="form-group"><label>支付日期</label><input name="pay_date" type="date"></div>
    <div class="form-group"><label>关联案件</label><select name="case_id"><option value="">-</option><% cases.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>描述</label><input name="description"></div>
    <div class="form-group"><label>备注</label><input name="remark"></div>
    <button class="btn btn-primary" type="submit">新增</button>
  </form>
  <table>
    <tr><th>ID</th><th>分类</th><th>子分类</th><th>金额</th><th>日期</th><th>关联案件</th><th>描述</th><th>操作</th></tr>
    <% costs.forEach(c => { %>
      <tr>
        <td><%= c.id %></td><td><span class="badge badge-blue"><%= c.category %></span></td><td><%= c.subcategory||'-' %></td>
        <td>¥<%= c.amount.toFixed(2) %></td><td><%= c.pay_date||'-' %></td><td><%= c.case_name||'-' %></td><td><%= c.description||'-' %></td>
        <td><a href="/costs/edit/<%= c.id %>" class="btn btn-primary">编辑</a> <form action="/costs/delete/<%= c.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger">删除</button></form></td>
      </tr>
    <% }) %>
  </table>
</main>
</body>
</html>