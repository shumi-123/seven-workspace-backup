<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>成本管理 | 财务结算系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="sidebar">
    <div class="logo">财务系统</div>
    <a href="/dashboard" class="nav-item">仪表盘</a>
    <a href="/clients" class="nav-item">客户管理</a>
    <a href="/projects" class="nav-item">项目管理</a>
    <a href="/payments" class="nav-item">收款管理</a>
    <a href="/invoices" class="nav-item">发票管理</a>
    <a href="/costs" class="nav-item active">成本管理</a>
    <a href="/performance" class="nav-item">绩效分配</a>
  </nav>
  <main class="content">
    <h1>成本管理</h1>
    <form class="form-inline" action="/costs/add" method="POST">
      <div class="form-group"><label>分类</label>
        <select name="category" required>
          <option value="工资">工资</option>
          <option value="办公">办公</option>
          <option value="平台">平台</option>
          <option value="其他">其他</option>
        </select>
      </div>
      <div class="form-group"><label>子分类</label><input name="subcategory" placeholder="如：房租、社保"></div>
      <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" required></div>
      <div class="form-group"><label>支付日期</label><input name="pay_date" type="date"></div>
      <div class="form-group"><label>描述</label><input name="description"></div>
      <div class="form-group"><label>备注</label><input name="remark"></div>
      <button class="btn btn-primary" type="submit">新增成本</button>
    </form>
    <table>
      <tr><th>ID</th><th>分类</th><th>子分类</th><th>金额</th><th>日期</th><th>描述</th><th>备注</th><th>操作</th></tr>
      <% costs.forEach(c => { %>
        <tr>
          <td><%= c.id %></td>
          <td><%= c.category %></td>
          <td><%= c.subcategory || '-' %></td>
          <td>¥<%= c.amount.toFixed(2) %></td>
          <td><%= c.pay_date || '-' %></td>
          <td><%= c.description || '-' %></td>
          <td><%= c.remark || '-' %></td>
          <td>
            <form action="/costs/delete/<%= c.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')">
              <button class="btn btn-danger" type="submit">删除</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </main>
</body>
</html>
