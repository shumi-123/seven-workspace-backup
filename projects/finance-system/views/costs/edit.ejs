<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑成本 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item active">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑成本</h1>
  <form class="form-inline" action="/costs/edit/<%= cost.id %>" method="POST">
    <div class="form-group"><label>分类</label><select name="category"><option value="律师工资" <%= cost.category==='律师工资'?'selected':'' %>>律师工资</option><option value="社保" <%= cost.category==='社保'?'selected':'' %>>社保</option><option value="公积金" <%= cost.category==='公积金'?'selected':'' %>>公积金</option><option value="办案费" <%= cost.category==='办案费'?'selected':'' %>>办案费</option><option value="平台费" <%= cost.category==='平台费'?'selected':'' %>>平台费</option><option value="办公费" <%= cost.category==='办公费'?'selected':'' %>>办公费</option><option value="律所管理费" <%= cost.category==='律所管理费'?'selected':'' %>>律所管理费</option><option value="其他" <%= cost.category==='其他'?'selected':'' %>>其他</option></select></div>
    <div class="form-group"><label>子分类</label><input name="subcategory" value="<%= cost.subcategory||'' %>"></div>
    <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" value="<%= cost.amount||0 %>"></div>
    <div class="form-group"><label>日期</label><input name="pay_date" type="date" value="<%= cost.pay_date||'' %>"></div>
    <div class="form-group"><label>说明</label><input name="description" value="<%= cost.description||'' %>"></div>
    <div class="form-group"><label>关联案件</label><select name="case_id"><option value="">-</option><% cases.forEach(c => { %><option value="<%= c.id %>" <%= cost.case_id==c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>备注</label><input name="remark" value="<%= cost.remark||'' %>"></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/costs" class="btn">取消</a>
  </form>
</main>
</body>
</html>
