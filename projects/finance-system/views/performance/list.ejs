<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>绩效分配 | 财务结算系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="sidebar">
    <div class="logo">财务系统</div>
    <a href="/dashboard" class="nav-item">仪表盘</a>
    <a href="/clients" class="nav-item">客户管理</a>
    <a href="/projects" class="nav-item">项目管理</a>
    <a href="/payments" class="nav-item">收款管理</a>
    <a href="/invoices" class="nav-item">发票管理</a>
    <a href="/costs" class="nav-item">成本管理</a>
    <a href="/performance" class="nav-item active">绩效分配</a>
  </nav>
  <main class="content">
    <h1>绩效分配</h1>
    <form class="form-inline" action="/performance/add" method="POST">
      <div class="form-group"><label>项目</label>
        <select name="project_id" required>
          <% projects.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>员工</label>
        <select name="staff_id" required>
          <% staff.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>绩效金额</label><input name="amount" type="number" step="0.01" required></div>
      <div class="form-group"><label>分配比例(%)</label><input name="ratio" type="number" step="0.01" placeholder="如 30"></div>
      <div class="form-group"><label>备注</label><input name="remark"></div>
      <button class="btn btn-primary" type="submit">新增绩效</button>
    </form>
    <table>
      <tr><th>ID</th><th>项目</th><th>员工</th><th>绩效金额</th><th>比例</th><th>备注</th><th>操作</th></tr>
      <% performance.forEach(pf => { %>
        <tr>
          <td><%= pf.id %></td>
          <td><%= pf.project_name || '-' %></td>
          <td><%= pf.staff_name || '-' %></td>
          <td>¥<%= pf.amount.toFixed(2) %></td>
          <td><%= pf.ratio ? pf.ratio + '%' : '-' %></td>
          <td><%= pf.remark || '-' %></td>
          <td>
            <form action="/performance/delete/<%= pf.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')">
              <button class="btn btn-danger" type="submit">删除</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </main>
</body>
</html>
