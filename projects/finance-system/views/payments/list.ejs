<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>收款管理 | 财务结算系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="sidebar">
    <div class="logo">财务系统</div>
    <a href="/dashboard" class="nav-item">仪表盘</a>
    <a href="/clients" class="nav-item">客户管理</a>
    <a href="/projects" class="nav-item">项目管理</a>
    <a href="/payments" class="nav-item active">收款管理</a>
    <a href="/invoices" class="nav-item">发票管理</a>
    <a href="/costs" class="nav-item">成本管理</a>
    <a href="/performance" class="nav-item">绩效分配</a>
  </nav>
  <main class="content">
    <h1>收款管理</h1>
    <form class="form-inline" action="/payments/add" method="POST">
      <div class="form-group"><label>项目</label>
        <select name="project_id" required>
          <% projects.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" required></div>
      <div class="form-group"><label>收款日期</label><input name="pay_date" type="date"></div>
      <div class="form-group"><label>方式</label>
        <select name="method">
          <option value="银行转账">银行转账</option>
          <option value="现金">现金</option>
          <option value="支付宝">支付宝</option>
          <option value="微信">微信</option>
        </select>
      </div>
      <div class="form-group"><label>状态</label>
        <select name="status">
          <option value="已到账">已到账</option>
          <option value="待到账">待到账</option>
        </select>
      </div>
      <div class="form-group"><label>备注</label><input name="remark"></div>
      <button class="btn btn-primary" type="submit">新增收款</button>
    </form>
    <table>
      <tr><th>ID</th><th>客户</th><th>项目</th><th>金额</th><th>日期</th><th>方式</th><th>状态</th><th>备注</th><th>操作</th></tr>
      <% payments.forEach(p => { %>
        <tr>
          <td><%= p.id %></td>
          <td><%= p.client_name || '-' %></td>
          <td><%= p.project_name || '-' %></td>
          <td>¥<%= p.amount.toFixed(2) %></td>
          <td><%= p.pay_date || '-' %></td>
          <td><%= p.method %></td>
          <td><%= p.status %></td>
          <td><%= p.remark || '-' %></td>
          <td>
            <form action="/payments/delete/<%= p.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')">
              <button class="btn btn-danger" type="submit">删除</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </main>
</body>
</html>
