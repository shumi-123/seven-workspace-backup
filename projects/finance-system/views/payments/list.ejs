<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>收款管理 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item active">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>收款管理</h1>
  <form class="form-inline" action="/payments/add" method="POST">
    <div class="form-group"><label>案件</label><select name="case_id" required><% cases.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" required></div>
    <div class="form-group"><label>收款日期</label><input name="pay_date" type="date"></div>
    <div class="form-group"><label>方式</label><select name="method"><option value="银行转账">银行转账</option><option value="现金">现金</option><option value="支付宝">支付宝</option><option value="微信">微信</option></select></div>
    <div class="form-group"><label>状态</label><select name="status"><option value="已到账">已到账</option><option value="待到账">待到账</option></select></div>
    <div class="form-group"><label>描述</label><input name="description"></div>
    <div class="form-group"><label>备注</label><input name="remark"></div>
    <button class="btn btn-primary" type="submit">新增</button>
  </form>
  <table>
    <tr><th>ID</th><th>委托人</th><th>案件</th><th>金额</th><th>日期</th><th>方式</th><th>状态</th><th>操作</th></tr>
    <% payments.forEach(p => { %>
      <tr>
        <td><%= p.id %></td><td><%= p.client_name||'-' %></td><td><%= p.case_name||'-' %></td>
        <td>¥<%= p.amount.toFixed(2) %></td><td><%= p.pay_date||'-' %></td>
        <td><%= p.method %></td><td><span class="badge <%= p.status==='已到账'?'badge-green':'badge-yellow' %>"><%= p.status %></span></td>
        <td><form action="/payments/delete/<%= p.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger">删除</button></form></td>
      </tr>
    <% }) %>
  </table>
</main>
</body>
</html>