<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑收款 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item active">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑收款</h1>
  <form class="form-inline" action="/payments/edit/<%= payment.id %>" method="POST">
    <div class="form-group"><label>案件</label><select name="case_id" required><% cases.forEach(c => { %><option value="<%= c.id %>" <%= payment.case_id==c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" value="<%= payment.amount||0 %>"></div>
    <div class="form-group"><label>收款日期</label><input name="pay_date" type="date" value="<%= payment.pay_date||'' %>"></div>
    <div class="form-group"><label>支付方式</label><select name="method"><option value="银行转账" <%= payment.method==='银行转账'?'selected':'' %>>银行转账</option><option value="现金" <%= payment.method==='现金'?'selected':'' %>>现金</option><option value="支付宝" <%= payment.method==='支付宝'?'selected':'' %>>支付宝</option><option value="微信" <%= payment.method==='微信'?'selected':'' %>>微信</option></select></div>
    <div class="form-group"><label>状态</label><select name="status"><option value="已到账" <%= payment.status==='已到账'?'selected':'' %>>已到账</option><option value="未到账" <%= payment.status==='未到账'?'selected':'' %>>未到账</option><option value="部分到账" <%= payment.status==='部分到账'?'selected':'' %>>部分到账</option></select></div>
    <div class="form-group"><label>说明</label><input name="description" value="<%= payment.description||'' %>"></div>
    <div class="form-group"><label>备注</label><input name="remark" value="<%= payment.remark||'' %>"></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/payments" class="btn">取消</a>
  </form>
</main>
</body>
</html>
