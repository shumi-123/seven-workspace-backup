<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑律师 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item active">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑律师</h1>
  <form class="form-inline" action="/lawyers/edit/<%= lawyer.id %>" method="POST">
    <div class="form-group"><label>姓名</label><input name="name" value="<%= lawyer.name %>" required></div>
    <div class="form-group"><label>执业证号</label><input name="license_no" value="<%= lawyer.license_no||'' %>"></div>
    <div class="form-group"><label>职位</label>
      <select name="position"><option value="合伙人" <%= lawyer.position==='合伙人'?'selected':'' %>>合伙人</option><option value="专职律师" <%= lawyer.position==='专职律师'?'selected':'' %>>专职律师</option><option value="实习律师" <%= lawyer.position==='实习律师'?'selected':'' %>>实习律师</option></select>
    </div>
    <div class="form-group"><label>基本工资</label><input name="base_salary" type="number" step="0.01" value="<%= lawyer.base_salary||0 %>"></div>
    <div class="form-group"><label>提成比例(%)</label><input name="commission_rate" type="number" step="0.01" value="<%= lawyer.commission_rate||0 %>"></div>
    <div class="form-group"><label>社保</label><input name="social_insurance" type="number" step="0.01" value="<%= lawyer.social_insurance||0 %>"></div>
    <div class="form-group"><label>公积金</label><input name="housing_fund" type="number" step="0.01" value="<%= lawyer.housing_fund||0 %>"></div>
    <div class="form-group"><label>备注</label><input name="remark" value="<%= lawyer.remark||'' %>"></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/lawyers" class="btn">取消</a>
  </form>
</main>
</body>
</html>
