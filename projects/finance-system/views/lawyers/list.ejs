<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>律师团队 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item active">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>律师团队管理</h1>
  <form class="form-inline" action="/lawyers/add" method="POST">
    <div class="form-group"><label>姓名</label><input name="name" required></div>
    <div class="form-group"><label>执业证号</label><input name="license_no"></div>
    <div class="form-group"><label>职位</label>
      <select name="role"><option value="合伙人">合伙人</option><option value="专职律师">专职律师</option><option value="实习律师">实习律师</option></select>
    </div>
    <div class="form-group"><label>基本工资</label><input name="base_salary" type="number" step="0.01"></div>
    <div class="form-group"><label>提成比例(%)</label><input name="commission_rate" type="number" step="0.01"></div>
    <div class="form-group"><label>社保</label><input name="social_insurance" type="number" step="0.01"></div>
    <div class="form-group"><label>公积金</label><input name="housing_fund" type="number" step="0.01"></div>
    <div class="form-group"><label>电话</label><input name="phone"></div>
    <div class="form-group"><label>入职日期</label><input name="entry_date" type="date"></div>
    <div class="form-group"><label>备注</label><input name="remark"></div>
    <button class="btn btn-primary" type="submit">新增</button>
  </form>
  <table>
    <tr><th>ID</th><th>姓名</th><th>执业证号</th><th>职位</th><th>基本工资</th><th>提成</th><th>社保</th><th>公积金</th><th>操作</th></tr>
    <% lawyers.forEach(l => { %>
      <tr>
        <td><%= l.id %></td><td><%= l.name %></td><td><%= l.license_no||'-' %></td>
        <td><span class="badge <%= l.role==='合伙人'?'badge-blue':l.role==='专职律师'?'badge-green':'badge-yellow' %>"><%= l.role %></span></td>
        <td>¥<%= l.base_salary.toFixed(2) %></td><td><%= l.commission_rate %>%</td>
        <td>¥<%= l.social_insurance.toFixed(2) %></td><td>¥<%= l.housing_fund.toFixed(2) %></td>
        <td><form action="/lawyers/delete/<%= l.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger">删除</button></form></td>
      </tr>
    <% }) %>
  </table>
</main>
</body>
</html>