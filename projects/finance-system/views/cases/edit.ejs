<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑案件 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item active">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑案件</h1>
  <form class="form-inline" action="/cases/edit/<%= caseItem.id %>" method="POST">
    <div class="form-group"><label>委托人</label><select name="client_id" required><% clients.forEach(c => { %><option value="<%= c.id %>" <%= caseItem.client_id==c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>案件编号</label><input name="case_no" value="<%= caseItem.case_no||'' %>"></div>
    <div class="form-group"><label>案件名称</label><input name="name" value="<%= caseItem.name %>" required></div>
    <div class="form-group"><label>类型</label><select name="type"><option value="民事" <%= caseItem.type==='民事'?'selected':'' %>>民事</option><option value="刑事" <%= caseItem.type==='刑事'?'selected':'' %>>刑事</option><option value="行政" <%= caseItem.type==='行政'?'selected':'' %>>行政</option><option value="商事" <%= caseItem.type==='商事'?'selected':'' %>>商事</option><option value="仲裁" <%= caseItem.type==='仲裁'?'selected':'' %>>仲裁</option><option value="法律顾问" <%= caseItem.type==='法律顾问'?'selected':'' %>>法律顾问</option></select></div>
    <div class="form-group"><label>阶段</label><select name="stage"><option value="立案" <%= caseItem.stage==='立案'?'selected':'' %>>立案</option><option value="调查" <%= caseItem.stage==='调查'?'selected':'' %>>调查</option><option value="庭审" <%= caseItem.stage==='庭审'?'selected':'' %>>庭审</option><option value="执行" <%= caseItem.stage==='执行'?'selected':'' %>>执行</option><option value="结案" <%= caseItem.stage==='结案'?'selected':'' %>>结案</option></select></div>
    <div class="form-group"><label>计费模式</label><select name="billing_mode"><option value="固定费用" <%= caseItem.billing_mode==='固定费用'?'selected':'' %>>固定费用</option><option value="小时计费" <%= caseItem.billing_mode==='小时计费'?'selected':'' %>>小时计费</option><option value="风险代理" <%= caseItem.billing_mode==='风险代理'?'selected':'' %>>风险代理</option></select></div>
    <div class="form-group"><label>小时费率</label><input name="hourly_rate" type="number" step="0.01" value="<%= caseItem.hourly_rate||0 %>"></div>
    <div class="form-group"><label>固定费用</label><input name="fixed_fee" type="number" step="0.01" value="<%= caseItem.fixed_fee||0 %>"></div>
    <div class="form-group"><label>风险比例(%)</label><input name="risk_rate" type="number" step="0.01" value="<%= caseItem.risk_rate||0 %>"></div>
    <div class="form-group"><label>合同金额</label><input name="contract_amount" type="number" step="0.01" value="<%= caseItem.contract_amount||0 %>"></div>
    <div class="form-group"><label>主办律师</label><select name="responsible_lawyer_id"><option value="">-</option><% lawyers.forEach(l => { %><option value="<%= l.id %>" <%= caseItem.responsible_lawyer_id==l.id?'selected':'' %>><%= l.name %></option><% }) %></select></div>
    <div class="form-group"><label>协办律师</label><select name="assistant_lawyer_id"><option value="">-</option><% lawyers.forEach(l => { %><option value="<%= l.id %>" <%= caseItem.assistant_lawyer_id==l.id?'selected':'' %>><%= l.name %></option><% }) %></select></div>
    <div class="form-group"><label>开始日期</label><input name="start_date" type="date" value="<%= caseItem.start_date||'' %>"></div>
    <div class="form-group"><label>结束日期</label><input name="end_date" type="date" value="<%= caseItem.end_date||'' %>"></div>
    <div class="form-group"><label>状态</label><select name="status"><option value="进行中" <%= caseItem.status==='进行中'?'selected':'' %>>进行中</option><option value="已结案" <%= caseItem.status==='已结案'?'selected':'' %>>已结案</option><option value="暂停" <%= caseItem.status==='暂停'?'selected':'' %>>暂停</option></select></div>
    <div class="form-group"><label>备注</label><input name="remark" value="<%= caseItem.remark||'' %>"></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/cases" class="btn">取消</a>
  </form>
</main>
</body>
</html>
