<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑发票 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item active">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑发票</h1>
  <form class="form-inline" action="/invoices/edit/<%= invoice.id %>" method="POST">
    <div class="form-group"><label>案件</label><select name="case_id" required><% cases.forEach(c => { %><option value="<%= c.id %>" <%= invoice.case_id==c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>发票号码</label><input name="invoice_no" value="<%= invoice.invoice_no||'' %>"></div>
    <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" value="<%= invoice.amount||0 %>"></div>
    <div class="form-group"><label>开票日期</label><input name="issue_date" type="date" value="<%= invoice.issue_date||'' %>"></div>
    <div class="form-group"><label>发票类型</label><select name="type"><option value="增值税普通发票" <%= invoice.type==='增值税普通发票'?'selected':'' %>>增值税普通发票</option><option value="增值税专用发票" <%= invoice.type==='增值税专用发票'?'selected':'' %>>增值税专用发票</option></select></div>
    <div class="form-group"><label>状态</label><select name="status"><option value="已开具" <%= invoice.status==='已开具'?'selected':'' %>>已开具</option><option value="已作废" <%= invoice.status==='已作废'?'selected':'' %>>已作废</option></select></div>
    <div class="form-group"><label>购方名称</label><input name="purchaser" value="<%= invoice.purchaser||'' %>"></div>
    <div class="form-group"><label>备注</label><input name="remark" value="<%= invoice.remark||'' %>"></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/invoices" class="btn">取消</a>
  </form>
</main>
</body>
</html>
