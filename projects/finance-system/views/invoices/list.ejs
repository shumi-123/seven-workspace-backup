<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>发票管理 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item active">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>发票管理 <a href="/export/invoices/list" class="btn">导出CSV</a></h1>
  <form class="form-inline" action="/invoices/add" method="POST">
    <div class="form-group"><label>案件</label><select name="case_id"><option value="">-</option><% cases.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>发票号码</label><input name="invoice_no" required></div>
    <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" required></div>
    <div class="form-group"><label>开票日期</label><input name="issue_date" type="date"></div>
    <div class="form-group"><label>状态</label><select name="status"><option value="已开具">已开具</option><option value="待开具">待开具</option><option value="已作废">已作废</option></select></div>
    <div class="form-group"><label>类型</label><select name="type"><option value="增值税普通发票">增值税普通发票</option><option value="增值税专用发票">增值税专用发票</option></select></div>
    <div class="form-group"><label>购买方</label><input name="purchaser"></div>
    <div class="form-group"><label>备注</label><input name="remark"></div>
    <button class="btn btn-primary" type="submit">新增</button>
  </form>
  <table>
    <tr><th>ID</th><th>案件</th><th>发票号码</th><th>金额</th><th>日期</th><th>状态</th><th>类型</th><th>购买方</th><th>操作</th></tr>
    <% invoices.forEach(i => { %>
      <tr>
        <td><%= i.id %></td><td><%= i.case_name||'-' %></td><td><%= i.invoice_no %></td>
        <td>¥<%= i.amount.toFixed(2) %></td><td><%= i.issue_date||'-' %></td>
        <td><span class="badge <%= i.status==='已开具'?'badge-green':i.status==='待开具'?'badge-yellow':'badge-red' %>"><%= i.status %></span></td>
        <td><%= i.type %></td><td><%= i.purchaser||'-' %></td>
        <td><a href="/invoices/edit/<%= i.id %>" class="btn btn-primary">编辑</a> <form action="/invoices/delete/<%= i.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger">删除</button></form></td>
      </tr>
    <% }) %>
  </table>
</main>
</body>
</html>