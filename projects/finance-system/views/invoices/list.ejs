<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>发票管理 | 财务结算系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="sidebar">
    <div class="logo">财务系统</div>
    <a href="/dashboard" class="nav-item">仪表盘</a>
    <a href="/clients" class="nav-item">客户管理</a>
    <a href="/projects" class="nav-item">项目管理</a>
    <a href="/payments" class="nav-item">收款管理</a>
    <a href="/invoices" class="nav-item active">发票管理</a>
    <a href="/costs" class="nav-item">成本管理</a>
    <a href="/performance" class="nav-item">绩效分配</a>
  </nav>
  <main class="content">
    <h1>发票管理</h1>
    <form class="form-inline" action="/invoices/add" method="POST">
      <div class="form-group"><label>项目</label>
        <select name="project_id">
          <option value="">-</option>
          <% projects.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>发票号码</label><input name="invoice_no" required></div>
      <div class="form-group"><label>金额</label><input name="amount" type="number" step="0.01" required></div>
      <div class="form-group"><label>开票日期</label><input name="issue_date" type="date"></div>
      <div class="form-group"><label>状态</label>
        <select name="status">
          <option value="已开具">已开具</option>
          <option value="待开具">待开具</option>
          <option value="已作废">已作废</option>
        </select>
      </div>
      <div class="form-group"><label>发票类型</label>
        <select name="type">
          <option value="增值税普通发票">增值税普通发票</option>
          <option value="增值税专用发票">增值税专用发票</option>
        </select>
      </div>
      <div class="form-group"><label>备注</label><input name="remark"></div>
      <button class="btn btn-primary" type="submit">新增发票</button>
    </form>
    <table>
      <tr><th>ID</th><th>项目</th><th>发票号码</th><th>金额</th><th>日期</th><th>状态</th><th>类型</th><th>备注</th><th>操作</th></tr>
      <% invoices.forEach(i => { %>
        <tr>
          <td><%= i.id %></td>
          <td><%= i.project_name || '-' %></td>
          <td><%= i.invoice_no %></td>
          <td>¥<%= i.amount.toFixed(2) %></td>
          <td><%= i.issue_date || '-' %></td>
          <td><%= i.status %></td>
          <td><%= i.type %></td>
          <td><%= i.remark || '-' %></td>
          <td>
            <form action="/invoices/delete/<%= i.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')">
              <button class="btn btn-danger" type="submit">删除</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </main>
</body>
</html>
