<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>工时记录 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item active">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>工时记录 <a href="/export/timeRecords/list" class="btn">导出CSV</a></h1>
  <form class="form-inline" action="/time-records/add" method="POST">
    <div class="form-group"><label>案件</label><select name="case_id" required><% cases.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>律师</label><select name="lawyer_id" required><% lawyers.forEach(l => { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></div>
    <div class="form-group"><label>日期</label><input name="work_date" type="date"></div>
    <div class="form-group"><label>工时(小时)</label><input name="hours" type="number" step="0.1"></div>
    <div class="form-group"><label>工作内容</label><input name="description"></div>
    <div class="form-group"><label>可计费</label><input type="checkbox" name="billable" value="1" checked></div>
    <button class="btn btn-primary" type="submit">新增</button>
  </form>
  <table>
    <tr><th>ID</th><th>案件</th><th>律师</th><th>日期</th><th>工时</th><th>计费</th><th>内容</th><th>操作</th></tr>
    <% records.forEach(r => { %>
      <tr>
        <td><%= r.id %></td><td><%= r.case_name||'-' %></td><td><%= r.lawyer_name||'-' %></td>
        <td><%= r.work_date||'-' %></td><td><%= r.hours %></td>
        <td><span class="badge <%= r.billable?'badge-green':'badge-gray' %>"><%= r.billable?'是':'否' %></span></td>
        <td><%= r.description||'-' %></td>
        <td><a href="/time-records/edit/<%= r.id %>" class="btn btn-primary">编辑</a> <form action="/time-records/delete/<%= r.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger">删除</button></form></td>
      </tr>
    <% }) %>
  </table>
</main>
</body>
</html>