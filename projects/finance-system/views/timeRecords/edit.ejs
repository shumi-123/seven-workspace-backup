<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑工时 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item active">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑工时记录</h1>
  <form class="form-inline" action="/time-records/edit/<%= record.id %>" method="POST">
    <div class="form-group"><label>案件</label><select name="case_id" required><% cases.forEach(c => { %><option value="<%= c.id %>" <%= record.case_id==c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>律师</label><select name="lawyer_id" required><% lawyers.forEach(l => { %><option value="<%= l.id %>" <%= record.lawyer_id==l.id?'selected':'' %>><%= l.name %></option><% }) %></select></div>
    <div class="form-group"><label>日期</label><input name="work_date" type="date" value="<%= record.work_date||'' %>"></div>
    <div class="form-group"><label>工时(小时)</label><input name="hours" type="number" step="0.1" value="<%= record.hours||0 %>"></div>
    <div class="form-group"><label>工作内容</label><input name="description" value="<%= record.description||'' %>"></div>
    <div class="form-group"><label>可计费</label><input type="checkbox" name="billable" value="1" <%= record.billable?'checked':'' %>></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/time-records" class="btn">取消</a>
  </form>
</main>
</body>
</html>
