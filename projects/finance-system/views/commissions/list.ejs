<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>案件提成 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item active">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>案件提成</h1>
  <form class="form-inline" action="/commissions/add" method="POST">
    <div class="form-group"><label>案件</label><select name="case_id" required><% cases.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>律师</label><select name="lawyer_id" required><% lawyers.forEach(l => { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></div>
    <div class="form-group"><label>提成金额</label><input name="amount" type="number" step="0.01" required></div>
    <div class="form-group"><label>分配比例(%)</label><input name="ratio" type="number" step="0.01"></div>
    <div class="form-group"><label>类型</label><select name="type"><option value="案件提成">案件提成</option><option value="奖金">奖金</option><option value="其他">其他</option></select></div>
    <div class="form-group"><label>备注</label><input name="remark"></div>
    <button class="btn btn-primary" type="submit">新增</button>
  </form>
  <table>
    <tr><th>ID</th><th>案件</th><th>律师</th><th>金额</th><th>比例</th><th>类型</th><th>备注</th><th>操作</th></tr>
    <% commissions.forEach(cc => { %>
      <tr>
        <td><%= cc.id %></td><td><%= cc.case_name||'-' %></td><td><%= cc.lawyer_name||'-' %></td>
        <td>¥<%= cc.amount.toFixed(2) %></td><td><%= cc.ratio?cc.ratio+'%':'-' %></td>
        <td><%= cc.type %></td><td><%= cc.remark||'-' %></td>
        <td><form action="/commissions/delete/<%= cc.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger">删除</button></form></td>
      </tr>
    <% }) %>
  </table>
</main>
</body>
</html>