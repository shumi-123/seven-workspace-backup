<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title>编辑提成 | 律所财务系统</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<nav class="sidebar">
  <div class="logo">律所财务系统</div>
  <a href="/dashboard" class="nav-item">仪表盘</a>
  <a href="/clients" class="nav-item">委托人</a>
  <a href="/lawyers" class="nav-item">律师团队</a>
  <a href="/cases" class="nav-item">案件管理</a>
  <a href="/time-records" class="nav-item">工时记录</a>
  <a href="/payments" class="nav-item">收款管理</a>
  <a href="/invoices" class="nav-item">发票管理</a>
  <a href="/costs" class="nav-item">成本管理</a>
  <a href="/commissions" class="nav-item active">案件提成</a>
  <a href="/salaries" class="nav-item">工资管理</a>
  <a href="/tax" class="nav-item">个税管理</a>
</nav>
<main class="content">
  <h1>编辑案件提成</h1>
  <form class="form-inline" action="/commissions/edit/<%= commission.id %>" method="POST">
    <div class="form-group"><label>案件</label><select name="case_id" required><% cases.forEach(c => { %><option value="<%= c.id %>" <%= commission.case_id==c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
    <div class="form-group"><label>律师</label><select name="lawyer_id" required><% lawyers.forEach(l => { %><option value="<%= l.id %>" <%= commission.lawyer_id==l.id?'selected':'' %>><%= l.name %></option><% }) %></select></div>
    <div class="form-group"><label>提成金额</label><input name="amount" type="number" step="0.01" value="<%= commission.amount||0 %>"></div>
    <div class="form-group"><label>比例(%)</label><input name="ratio" type="number" step="0.01" value="<%= commission.ratio||0 %>"></div>
    <div class="form-group"><label>类型</label><select name="type"><option value="案件提成" <%= commission.type==='案件提成'?'selected':'' %>>案件提成</option><option value="绩效奖金" <%= commission.type==='绩效奖金'?'selected':'' %>>绩效奖金</option><option value="年终奖" <%= commission.type==='年终奖'?'selected':'' %>>年终奖</option></select></div>
    <div class="form-group"><label>备注</label><input name="remark" value="<%= commission.remark||'' %>"></div>
    <button class="btn btn-primary" type="submit">保存</button>
    <a href="/commissions" class="btn">取消</a>
  </form>
</main>
</body>
</html>
