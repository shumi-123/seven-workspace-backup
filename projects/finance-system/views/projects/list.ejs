<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>项目管理 | 财务结算系统</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="sidebar">
    <div class="logo">财务系统</div>
    <a href="/dashboard" class="nav-item">仪表盘</a>
    <a href="/clients" class="nav-item">客户管理</a>
    <a href="/projects" class="nav-item active">项目管理</a>
    <a href="/payments" class="nav-item">收款管理</a>
    <a href="/invoices" class="nav-item">发票管理</a>
    <a href="/costs" class="nav-item">成本管理</a>
    <a href="/performance" class="nav-item">绩效分配</a>
  </nav>
  <main class="content">
    <h1>项目管理</h1>
    <form class="form-inline" action="/projects/add" method="POST">
      <div class="form-group"><label>客户</label>
        <select name="client_id" required>
          <% clients.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>项目名称</label><input name="name" required></div>
      <div class="form-group"><label>状态</label>
        <select name="status">
          <option value="进行中">进行中</option>
          <option value="已完成">已完成</option>
          <option value="暂停">暂停</option>
        </select>
      </div>
      <div class="form-group"><label>开始日期</label><input name="start_date" type="date"></div>
      <div class="form-group"><label>结束日期</label><input name="end_date" type="date"></div>
      <div class="form-group"><label>合同金额</label><input name="contract_amount" type="number" step="0.01"></div>
      <div class="form-group"><label>备注</label><input name="remark"></div>
      <button class="btn btn-primary" type="submit">新增项目</button>
    </form>
    <table>
      <tr><th>ID</th><th>客户</th><th>名称</th><th>状态</th><th>开始</th><th>结束</th><th>合同金额</th><th>备注</th><th>操作</th></tr>
      <% projects.forEach(p => { %>
        <tr>
          <td><%= p.id %></td>
          <td><%= p.client_name || '-' %></td>
          <td><%= p.name %></td>
          <td><%= p.status %></td>
          <td><%= p.start_date || '-' %></td>
          <td><%= p.end_date || '-' %></td>
          <td>¥<%= p.contract_amount ? p.contract_amount.toFixed(2) : '0.00' %></td>
          <td><%= p.remark || '-' %></td>
          <td>
            <form action="/projects/delete/<%= p.id %>" method="POST" style="display:inline" onsubmit="return confirm('确定删除？')">
              <button class="btn btn-danger" type="submit">删除</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </main>
</body>
</html>
